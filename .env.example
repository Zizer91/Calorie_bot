# === Telegram ===
# Токен — у @BotFather, chat_id — у @userinfobot (напишите ему /start)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# === Критерии ===
MAX_PRICE=11800000
ROOMS=1,2,3
# 1-к принимаются, только если кухня не меньше этого (под кухню-гостиную + спальню)
MIN_KITCHEN_1K=12
MIN_AREA_1K=36
MAX_METRO_WALK_MIN=15
# панельные и блочные дома — не старше этого года
MIN_PANEL_YEAR=1970
# монолит (без кирпича) — по умолчанию не присылать
ALLOW_MONOLITH=false
# присылать, если сайт не указал тип дома (с пометкой ⚠️)
ALLOW_UNKNOWN_BUILDING=true
ALLOW_UNKNOWN_METRO=false

# === Работа бота ===
SOURCES=cian,avito,domclick,yandex,etagi,n1
PAGES_PER_SOURCE=3
MAX_DETAILS_PER_SOURCE=20
INTERVAL_MIN=20
MAX_MESSAGES_PER_RUN=30
NOTIFY_PRICE_DROP=false
DB_PATH=flats.db
DELAY_MIN=2
DELAY_MAX=5
# Сохранять скачанные страницы сюда (для отладки парсеров)
DEBUG_DIR=
